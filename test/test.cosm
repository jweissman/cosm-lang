## Tiny Cosm-native test harness exercise

require "cosm/spec.cosm"

assert_equal(Kernel.inspect(Kernel), "#<Kernel>")

def kernel_examples()
  it("math smoke") do
    expect(1 + 1).to_eql(2)
  end
  it("expectEqual smoke") do
    expect([1, 2]).to_eql([1, 2])
  end
  it("inspect smoke") do
    assert(Kernel.inspect(Kernel) == "#<Kernel>")
  end
  it("explicit send smoke") do
    assert(Kernel.dispatch(1, :plus, 2) == 3)
  end
end

def callable_examples()
  let id = ->(x) { x }
  it("function call smoke") do
    assert(id.call(4) == 4)
  end
  it("method call smoke") do
    assert(Kernel.method(:assert).call(true, "ok") == true)
  end
end

class HarnessThing
  def init(value)
    @value = value
    assert(@value == value)
  end
end

def object_examples()
  it("class smoke") do
    assert(HarnessThing.new(3).value == 3)
  end
  it("sad path") do
    error = expect(->() { assert(false, "boom") }).to_raise("Assertion failed: boom")
    assert_equal(error.message, "Assertion failed: boom")
  end
end

suite("kernel basics", kernel_examples)
suite("callables", callable_examples)
suite("objects", object_examples)

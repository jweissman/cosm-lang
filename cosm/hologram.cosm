module Hologram
  def status = HologramHandle.status()

  def wrap value = HologramHandle.wrap(value)

  def project_json value = HologramHandle.projectJson(value)

  def readable_surface = status().readable_surface

  def intended_role = status().intended_role

  def writable_targets = status().writable_targets

  def host_wrapper_kinds = status().host_wrapper_kinds
end

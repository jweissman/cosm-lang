def status = ai.status();

def config = ai.config();

def health = ai.health();

def complete(prompt) = ai.complete(prompt);

def compare(left, right) = ai.compare(left, right);

def boundary()
  {
    mode: "explicit-semantic-boundary",
    cast: "Cosm::AI.cast(prompt, schema_or_model)",
    compare: "Cosm::AI.compare(left, right)",
    semantic_eq: "\"left\" ~= \"right\"",
    deferred_operator: "~",
    deterministic_validation: "Schema.validate(...) / Data.model(...).validate(...)",
    configured: ai.config().configured
  }
end

def schema_for(target)
  let maybe_schema = Kernel.try(->() { target.schema() })
  if maybe_schema.ok then
    maybe_schema.value
  else
    target
  end
end

def cast(prompt, target) = ai.cast(prompt, schema_for(target));

def chat_cast(messages, target) = ai.chat_cast(messages, schema_for(target));

def reply(prompt, target) = cast(prompt, target);

def stream(prompt)
  ai.stream(prompt) do |event|
    yield(event)
  end
end

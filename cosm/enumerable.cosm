module Enumerable
  def any(callback = nihil) = callback.nihil?() ? self.present?() : (self.find(callback).nihil?() ? false : true)

  def all(callback)
    self.reduce(true) do |acc, value|
      acc.falsy?() ? false : callback(value)
    end
  end

  def none?() = self.empty?()

  def none() = self.none?()

  def one?() = self.length == 1

  def one() = self.one?()

  def filter(callback) = self.select(callback)

  def compact_map(callback)
    let missing = :__cosm_compact_map_missing__
    self.reduce([]) do |acc, first, second = missing|
      let mapped = second == missing ? callback(first) : callback(first, second)
      mapped.nihil?() ? acc : acc.append(mapped)
    end
  end

  def find_map(callback)
    let missing = :__cosm_find_map_missing__
    let result = self.reduce(missing) do |acc, first, second = missing|
      if acc != missing then
        acc
      else
        let mapped = second == missing ? callback(first) : callback(first, second)
        mapped.nihil?() ? missing : mapped
      end
    end
    result == missing ? nihil : result
  end

  def flat_map(callback)
    self.map(callback).reduce([]) do |acc, value|
      if value.class_name() == "Array" then
        value.reduce(acc) do |next, item|
          next.append(item)
        end
      else
        acc.append(value)
      end
    end
  end

  def sum() = self.reduce(0) do |acc, value| acc + value end

  def sum_by(callback)
    let missing = :__cosm_sum_by_missing__
    self.reduce(0) do |acc, first, second = missing|
      acc + (second == missing ? callback(first) : callback(first, second))
    end
  end
end

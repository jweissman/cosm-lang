module Mapping
  def first()
    let pairs = self.take(1).map(->(key, value) { [key, value] })
    pairs.length == 1 ? pairs.first() : false
  end

  def keys()
    self.map(->(key, _value) { key })
  end

  def values()
    self.map(->(_key, value) { value })
  end

  def has_key(target)
    self.find(->(key, _value) { key == target }) != false
  end
end

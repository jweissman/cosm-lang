class Hash < Object
  def at(key)
    let target_key = key.class_name() == "Symbol" ? key.to_s() : key
    self.find_map do |current_key, value|
      current_key == target_key ? value : nihil
    end
  end
end

Hash.include(Cosm::Core::Collection)
Hash.include(Cosm::Enumerable)
Hash.include(Cosm::Core::Mapping)

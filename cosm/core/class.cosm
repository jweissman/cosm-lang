class Class < Module
  def lineage() = self.lineage_from(self, [])

  def lineage_from(current, labels)
    if current.nihil?() then
      labels
    else
      let next_labels = labels.append(current.name)
      current.name == "BasicObject" ? next_labels : self.lineage_from(current.superclass, next_labels)
    end
  end

  def ancestor_names() = self.lineage()

  def instance_method(name) = self.methodTable.get(name)

  def instance_method_names()
    self.methodTable.keys().map do |name|
      name.name
    end
  end

  def included_module_names()
    self.includedModules.map do |mod|
      mod.name
    end
  end

  def class_method(name) = self.classMethod(name)

  def superclass_name() = self.name == "BasicObject" ? nihil : (self.superclass.nihil?() ? nihil : self.superclass.name)

  def root?() = self.name == "BasicObject" ? true : self.superclass.nihil?()

  def includes_module?(target)
    let target_name = target.class_name() == "Module" ? target.name : target
    self.included_module_names().find do |name|
      name == target_name
    end.nihil?() ? false : true
  end

  def inherits_from?(target)
    let target_name = target.class_name() == "Class" ? target.name : target
    self.lineage().find do |name|
      name == target_name
    end.nihil?() ? false : true
  end
end

require "cosm/hologram"

let headers = http.headers({ accept: "notebook" })
let reflected = Mirror.reflect(headers)
let reflected_inspect = reflected.inspect()
let holo = Cosm::Hologram.wrap(headers)
holo.set("x-runtime", "cosm")
[Mirror.status().mode, Cosm::Hologram.status().intended_role, reflected_inspect, holo.get(:accept), holo.get("x-runtime")]

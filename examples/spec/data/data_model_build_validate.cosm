let Ticket = Data.model("Ticket", {
  title: Data.string(),
  priority: Data.enum("low", "high")
}, {
  priority: "low"
})

let built = Ticket.build({ title: "Demo" })
let invalid = Kernel.tryValidate({ title: "Demo", priority: "urgent" }, Ticket)
[built.at("title"), built.at("priority"), invalid.ok]

require "lib/support/models"
require "lib/support/prompt_data"

def reply_prompt_from_transcript(transcript, latest_text) = Prompt.text("""
#{Support::PromptData.iapetus_system()}
Return JSON matching this schema:
#{Kernel.inspect(Support::Models.agent_turn_plan.jsonSchema())}

Transcript so far:
#{transcript}

Latest user message:
#{latest_text}
""");

def reply_prompt_from_context(transcript, latest_text, context) = Prompt.text("""
#{Support::PromptData.iapetus_system()}
Return JSON matching this schema:
#{Kernel.inspect(Support::Models.agent_turn_plan.jsonSchema())}

Attached page context:
#{context}

Transcript so far:
#{transcript}

Latest user message:
#{latest_text}
""");

def stream_prompt_from_transcript(transcript, latest_text) = Prompt.text("""
#{Support::PromptData.iapetus_system()}
Do not describe hidden tools or hidden runtime capabilities.
Return only the user-facing reply text, with no JSON wrapper.

Transcript so far:
#{transcript}

Latest user message:
#{latest_text}
""");

def stream_prompt_from_context(transcript, latest_text, context) = Prompt.text("""
#{Support::PromptData.iapetus_system()}
Do not describe hidden tools or hidden runtime capabilities.
Return only the user-facing reply text, with no JSON wrapper.

Attached page context:
#{context}

Transcript so far:
#{transcript}

Latest user message:
#{latest_text}
""");

def system_message() = { role: "system", content: Support::PromptData.iapetus_system };

def context_message(context) = { role: "system", content: "Attached page context:\n" + context };

def legacy_transcript_message(transcript) = { role: "system", content: "Legacy transcript so far:\n" + transcript };

def history_messages(conversation)
  let entries = conversation.messages.map do |entry|
    { role: entry.role, content: entry.text }
  end
  entries
end

def latest_user_message(inbound) = { role: "user", content: inbound.text };

def reply_messages(conversation, inbound)
  let base = [system_message()]
  let with_context = conversation.context.nihil?() ? base : base.append(context_message(conversation.context))
  let with_transcript = conversation.transcript.nihil?() ? with_context : with_context.append(legacy_transcript_message(conversation.transcript))
  let message_history = history_messages(conversation)
  let with_history = message_history.reduce(with_transcript) do |acc, entry|
    acc.append(entry)
  end
  with_history.append(latest_user_message(inbound))
end

def reply_messages_preview(conversation, inbound) = reply_messages(conversation, inbound);

def reply_prompt(conversation, inbound) = reply_prompt_from_transcript(Kernel.inspect(conversation.messages), inbound.text);

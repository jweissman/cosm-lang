require "lib/support/models"
require "lib/agent/config"
require "lib/agent/runtime"
require "lib/agent/store"
require "lib/agent/slack_client"
require "lib/agent/slack_diag"
require "cosm/ai"
require "cosm/hologram"

def slack_config = Agent::Config.slack_config_status()

def parse_payload(req)
  Kernel.try do
    Kernel.parseJson(req.bodyText())
  end
end

def payload_field(value, name)
  Kernel.try do
    Cosm::Hologram.wrap(value).get(name)
  end
end

def health_payload(path)
  {
    ok: true,
    path: path,
    pid: Process.pid(),
    platform: Process.platform(),
    arch: Process.arch()
  }
end

def ready_payload(path)
  let cfg = slack_config()
  let signing_secret_ok = cfg.signing_secret != false
  let bot_token_ok = cfg.bot_token != false
  let storage_ok = Agent::Store.writable()
  let ai_config = Cosm::AI.config()
  let ai_health = Cosm::AI.health()
  let ok = signing_secret_ok && bot_token_ok && storage_ok && ai_config.configured && ai_health.ok
  {
    ok: ok,
    path: path,
    slack: {
      webhook_driven: true,
      dm_enabled: true,
      mention_mode: true,
      channel_mentions_enabled: Agent::Config.slack_channel_ingress_enabled(),
      allowed_channels: Agent::Config.slack_allowed_channels(),
      expected_events: Agent::SlackDiag.expected_events(),
      required_scopes: Agent::SlackDiag.required_ingress_scopes(),
      signing_secret: signing_secret_ok,
      bot_token: bot_token_ok,
      app_id: cfg.app_id,
      client_id: cfg.client_id,
      client_secret: cfg.client_secret,
      api_url: cfg.api_url,
      storage_dir: cfg.storage_dir,
      storage_writable: storage_ok
    },
    ai: {
      configured: ai_config.configured,
      health: ai_health.ok
    },
    agent: Agent::Runtime.status()
  }
end

def status_payload(path)
  {
    ok: true,
    path: path,
    slack: {
      transport: "slack",
      webhook_driven: true,
      dm_enabled: true,
      mention_mode: true,
      channel_mentions_enabled: Agent::Config.slack_channel_ingress_enabled(),
      allowed_channels: Agent::Config.slack_allowed_channels(),
      expected_events: Agent::SlackDiag.expected_events(),
      required_scopes: Agent::SlackDiag.required_ingress_scopes(),
      config: slack_config(),
      storage_writable: Agent::Store.writable()
    },
    ai: {
      config: Cosm::AI.config(),
      health: Cosm::AI.health()
    },
    agent: Agent::Runtime.status()
  }
end

def health(req)
  HttpResponse.json(health_payload(req.path), 200)
end

def ready(req)
  let payload = ready_payload(req.path)
  HttpResponse.json(payload, payload.ok ? 200 : 503)
end

def status(req)
  HttpResponse.json(status_payload(req.path), 200)
end

def events(req)
  let verification = verify_request(req)
  if verification.ok == false then
    puts("[slack] verification failed: " + verification.error)
    HttpResponse.json({ ok: false, error: verification.error }, verification.status)
  else
    let payload_result = parse_payload(req)
    if payload_result.ok == false then
      puts("[slack] invalid json payload")
      HttpResponse.json({ ok: false, error: "Slack request body must be valid JSON" }, 400)
    else
        let payload = payload_result.value
        let challenge = url_verification(payload)
        if challenge != false then
          puts("[slack] received url_verification challenge")
          HttpResponse.json({ challenge: challenge }, 200)
        else
          let inbound = extract_inbound(payload)
          if inbound == false then
            Agent::Store.note_activity("slack", "ignored", "ignored inbound Slack event")
            puts("[slack] ignored unsupported, unallowed, or bot event")
            HttpResponse.json({ ok: true, ignored: true }, 200)
          else
            let event_key = event_key(payload, inbound)
            Agent::Store.note_activity(inbound.channel + ":" + inbound.thread, "accepted", inbound.source + " " + inbound.channel)
            puts("[slack] accepted inbound " + inbound.source + " " + inbound.channel + " thread " + inbound.thread + " event " + event_key)
            if Agent::Runtime.processed(inbound, event_key) then
              Agent::Store.note_activity(inbound.channel + ":" + inbound.thread, "deduped", event_key)
              puts("[slack] deduped delivery " + event_key)
              HttpResponse.json({ ok: true, deduped: true }, 200)
            else
              handle_inbound(inbound, event_key)
          end
        end
      end
    end
  end
end

def handle_inbound(inbound, event_key)
  let turn = Agent::Runtime.execute_stored_turn(inbound)
  puts("[slack] turn " + turn.outcome + " for " + turn.conversation.key)
  if turn.reply.degraded == true then
    let reason = turn.reply.failure_reason == false ? "unknown" : turn.reply.failure_reason
    puts("[slack] degraded reply for " + turn.conversation.key + ": " + reason)
  else
    true
  end
  let posted = post_reply(turn.conversation, turn.reply.text)
  if posted.ok then
    Agent::Runtime.mark_processed(turn.conversation, event_key)
    Agent::Store.note_activity(turn.conversation.key, "replied", turn.reply.text.length > 60 ? "reply posted" : turn.reply.text)
    puts("[slack] reply posted for " + turn.conversation.key)
    HttpResponse.json({
      ok: true,
      replied: true,
      command: turn.command,
      session_name: turn.conversation.session_name
    }, 200)
  else
    let message = turn.command == false ? "[slack] outbound failure for thread " + inbound.thread + ": " + posted.error : "[slack] outbound failure for command " + turn.command + ": " + posted.error
    Agent::Store.note_activity(turn.conversation.key, "outbound_failure", posted.error)
    puts(message)
    HttpResponse.json({ ok: false, error: posted.error }, 502)
  end
end

def post_reply(conversation, text)
  Agent::SlackClient.post_message(conversation.channel, text, conversation.thread)
end

def verify_request(req)
  let signing_secret = Agent::Config.slack_signing_secret()
  if signing_secret == false then
    { ok: false, status: 500, error: "Slack signing secret is not configured" }
  else
    let timestamp = header(req, "x-slack-request-timestamp")
    let signature = header(req, "x-slack-signature")
    if timestamp == false || signature == false then
      { ok: false, status: 401, error: "Invalid Slack signature" }
    else
      let timestamp_seconds = Kernel.try do
        timestamp.to_i()
      end
      if timestamp_seconds.ok == false then
        { ok: false, status: 401, error: "Invalid Slack signature" }
      else
        if (Time.now() - (timestamp_seconds.value * 1000)) > 300000 then
          { ok: false, status: 401, error: "Slack request timestamp is too old" }
        else
          let expected = "v0=" + Kernel.hmacSha256(signing_secret, "v0:" + timestamp + ":" + req.bodyText())
          expected == signature ? { ok: true, status: 200, error: false } : { ok: false, status: 401, error: "Invalid Slack signature" }
        end
      end
    end
  end
end

def url_verification(payload)
  let type_value = payload_field(payload, :type)
  if type_value.ok && type_value.value == "url_verification" then
    let challenge = payload_field(payload, :challenge)
    challenge.ok ? challenge.value : false
  else
    false
  end
end

def extract_inbound(payload)
  let payload_type = payload_field(payload, :type)
  if payload_type.ok == false || payload_type.value != "event_callback" then
    false
  else
    let event_result = payload_field(payload, :event)
    if event_result.ok == false then
      false
    else
      let event = event_result.value
      let type_value = payload_field(event, :type)
      let channel_type = payload_field(event, :channel_type)
      let channel = payload_field(event, :channel)
      let user = payload_field(event, :user)
      let text = payload_field(event, :text)
      let ts = payload_field(event, :ts)
      let bot_id = payload_field(event, :bot_id)
      let subtype = payload_field(event, :subtype)
      if type_value.ok == false || channel.ok == false || user.ok == false || text.ok == false || ts.ok == false then
        false
      else
        if bot_id.ok || subtype.ok then
          false
        else
          let effective_channel_kind = channel_type.ok ? channel_type.value : inferred_channel_kind(channel.value)
          let kind = inbound_kind(type_value.value, effective_channel_kind)
          if kind == false then
            false
          else
            let thread_value = payload_field(event, :thread_ts)
            let thread = thread_value.ok ? thread_value.value : ts.value
            if allowed_inbound(kind, channel.value, thread) == false then
              false
            else
              let value = {
                channel: channel.value,
                thread: thread,
                user: user.value,
                text: sanitized_text(kind, text.value),
                ts: ts.value,
                source: kind,
                channel_kind: effective_channel_kind
              }
              Support::Models.inbound_message.validate(value)
              value
            end
          end
        end
      end
    end
  end
end

def inferred_channel_kind(channel_id)
  channel_id.startsWith("D") ? "im" : (channel_id.startsWith("G") ? "group" : "channel")
end

def inbound_kind(event_type, channel_kind)
  if event_type == "app_mention" then
    channel_kind == "channel" || channel_kind == "group" ? "app_mention" : false
  else
    if event_type != "message" then
      false
    else
      channel_kind == "im" ? "dm" : (channel_kind == "channel" || channel_kind == "group" ? "thread_reply" : false)
    end
  end
end

def allowed_channel(channel_id)
  Agent::Config.slack_allowed_channels().find do |entry|
    entry == channel_id
  end != false
end

def activated_thread(channel_id, thread)
  Agent::Store.load_record(Agent::Runtime.conversation_key(channel_id, thread, "slack")) != false
end

def allowed_inbound(kind, channel_id, thread)
  if kind == "dm" then
    true
  else
    if allowed_channel(channel_id) == false then
      false
    else
      kind == "app_mention" ? true : activated_thread(channel_id, thread)
    end
  end
end

def sanitized_text(kind, text)
  if kind == "app_mention" then
    let trimmed = text.trim()
    trimmed == "" ? "help" : trimmed
  else
    text
  end
end

def event_key(payload, inbound)
  let top_level = payload_field(payload, :event_id)
  top_level.ok ? top_level.value : inbound.channel + ":" + inbound.thread + ":" + inbound.user + ":" + inbound.ts
end

def header(req, name)
  req.headers.has(name) ? req.headers.get(name) : false
end

def api_url()
  Agent::Config.slack_api_url()
end

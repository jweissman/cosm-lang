require "lib/agent/config"
require "lib/agent/slack_client"

def usage()
  """Usage: bun bin/cosm lib/agent/send_dm.cosm <channel_id> <text>

<channel_id> is a Slack conversation id such as D... (DM), C... (public channel), or G... (private channel).
Example: bun bin/cosm lib/agent/send_dm.cosm C01234567 "hello from Cosm"
"""
end

def post_message(channel_id, text)
  Agent::SlackClient.post_message(channel_id, text)
end

def debug_config(channel_id = false, text = false)
  {
    target_channel_id: channel_id,
    text: text,
    config: Agent::Config.slack_config_status()
  }
end

def args_from(argv)
  let index = 0
  let channel_id = false
  let text_parts = []

  argv.each do |entry|
    if index == 3 then
      channel_id = entry
    else
      if index > 3 then
        text_parts = text_parts.append(entry)
      else
        true
      end
    end
    index = index + 1
  end

  let text = text_parts.length == 0 ? false : text_parts.join(" ")
  if channel_id == false || text == false then
    false
  else
    { channel_id: channel_id, text: text }
  end
end

def run(argv = false)
  let args = argv == false ? Process.argv() : argv
  let parsed = args_from(args)
  if parsed == false then
    warn(usage())
    Process.exit(1)
  else
    puts("posting to channel_id: " + parsed.channel_id)
    let result = post_message(parsed.channel_id, parsed.text)
    if result.ok then
      let ts_text = result.ts == false ? "(none)" : result.ts
      puts("ok")
      puts("channel_id: " + result.channel_id)
      puts("ts: " + ts_text)
      result
    else
      warn("slack dm failed: " + result.error)
      warn(Kernel.inspect(debug_config(parsed.channel_id, parsed.text)))
      Process.exit(1)
    end
  end
end

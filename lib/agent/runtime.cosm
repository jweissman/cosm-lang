require "lib/support/controller"
require "lib/support/models"
require "lib/agent/store"
require "lib/agent/config"
require "cosm/ai"

def identity = {
  name: "iapetus",
  mode: "single-turn",
  control: "cosm",
  session_prefix: "agent:",
  persistence: "file-backed-thread"
}

def conversation_key(channel, thread, transport = nihil) = transport.nihil?() || transport == "slack" ? channel + ":" + thread : transport + ":" + channel + ":" + thread

def session_name(key) = identity().session_prefix + key

def target(channel, thread, transport = "slack", user = "visitor")
  {
    channel: channel,
    thread: thread,
    transport: transport,
    user: user
  }
end

def local_target(name = "iapetus")
  target("cli", name, "local", "you")
end

def inbound_for_target(target, text, ts = nihil)
  Support::Models.inbound_message.build({
    channel: target.channel,
    thread: target.thread,
    user: target.user,
    text: text,
    ts: ts.nihil?() ? Time.isoNow() : ts
  })
end

def conversation_for_target(target, transcript = nihil, context = nihil)
  let now = Time.isoNow()
  let key = conversation_key(target.channel, target.thread, target.transport)
  Support::Models.conversation.build({
    agent: identity().name,
    transport: target.transport,
    key: key,
    channel: target.channel,
    thread: target.thread,
    messages: [],
    session_name: session_name(key),
    session_length: 0,
    transcript: transcript,
    context: context,
    created_at: now,
    updated_at: now
  })
end

def conversation_for_inbound(inbound, transcript = nihil, context = nihil, transport = "slack")
  conversation_for_target(target(inbound.channel, inbound.thread, transport, inbound.user), transcript, context)
end

def load_conversation_for_target(target, transcript = nihil, context = nihil)
  let key = conversation_key(target.channel, target.thread, target.transport)
  let loaded = Agent::Store.load_record(key)
  loaded.nihil?() ? conversation_for_target(target, transcript, context) : loaded.conversation
end

def load_conversation(inbound, transcript = nihil, context = nihil, transport = "slack")
  load_conversation_for_target(target(inbound.channel, inbound.thread, transport, inbound.user), transcript, context)
end

def save_conversation(conversation) = Agent::Store.save_conversation(conversation).conversation;

def processed(inbound, event_key, transport = "slack") = Agent::Store.processed(conversation_key(inbound.channel, inbound.thread, transport), event_key)

def mark_processed(conversation, event_key) = Agent::Store.mark_processed(conversation, event_key)

def reset_target(target, transcript = nihil, context = nihil)
  let fresh = conversation_for_target(target, transcript, context)
  save_conversation(fresh)
end

def reset_conversation(inbound, transcript = nihil, context = nihil, transport = "slack")
  reset_target(target(inbound.channel, inbound.thread, transport, inbound.user), transcript, context)
end

def command_name(text) = text == "help" || text == "/help" ? "help" : (text == "reset" || text == "/reset" ? "reset" : (text == "status" || text == "/status" ? "status" : nihil))

def from_command(conversation, inbound, command)
  if command == "reset" then
    let fresh = conversation_for_target(target(inbound.channel, inbound.thread, conversation.transport, inbound.user), conversation.transcript, conversation.context)
    Session.named(fresh.session_name).reset()
    let reply = Support::Controller.command_reply(fresh, command)
    Support::Models.agent_turn_result.build({ conversation: fresh, inbound: inbound, reply: reply, command: command, outcome: "command" })
  else
    let reply = Support::Controller.command_reply(conversation, command)
    let updated = Support::Controller.next_conversation(conversation, inbound, reply)
    Support::Models.agent_turn_result.build({ conversation: updated, inbound: inbound, reply: reply, command: command, outcome: "command" })
  end
end

def fallback_reply(conversation, inbound, error_message) = Support::Controller.fallback(conversation, inbound, error_message)

def activity_summary(turn)
  let base = turn.command.nihil?() ? turn.outcome : "command:" + turn.command
  let text = turn.reply.text
  let preview = text.length > 80 ? "[truncated] " + text.length.to_s() + " chars" : text
  base + " " + preview
end

def from_controller_turn(conversation, inbound)
  let outcome = Kernel.try do
    Support::Controller.turn(conversation, inbound)
  end
  let turn = outcome.ok ? outcome.value : Support::Models.agent_turn_result.build({
    conversation: Support::Controller.next_conversation(conversation, inbound, fallback_reply(conversation, inbound, outcome.error.message)),
    inbound: inbound,
    reply: fallback_reply(conversation, inbound, outcome.error.message),
    outcome: "fallback"
  })
  Support::Models.agent_turn_result.build({
    conversation: turn.conversation,
    inbound: turn.inbound,
    plan: turn.plan,
    reply: turn.reply,
    command: turn.command,
    outcome: turn.outcome
  })
end

def execute_turn(conversation, inbound)
  let command = command_name(inbound.text)
  command.nihil?() ? from_controller_turn(conversation, inbound) : from_command(conversation, inbound, command)
end

def execute_stored_turn(inbound, transcript = nihil, context = nihil)
  let conversation = load_conversation(inbound, transcript, context)
  let turn = execute_turn(conversation, inbound)
  let saved = save_conversation(turn.conversation)
  Agent::Store.note_activity(saved.key, turn.outcome, activity_summary(turn))
  Support::Models.agent_turn_result.build({ conversation: saved, inbound: turn.inbound, plan: turn.plan, reply: turn.reply, command: turn.command, outcome: turn.outcome })
end

def execute_stored_turn_for_target(target, text, transcript = nihil, context = nihil)
  let inbound = inbound_for_target(target, text)
  let conversation = load_conversation_for_target(target, transcript, context)
  let turn = execute_turn(conversation, inbound)
  let saved = save_conversation(turn.conversation)
  Agent::Store.note_activity(saved.key, turn.outcome, activity_summary(turn))
  Support::Models.agent_turn_result.build({ conversation: saved, inbound: turn.inbound, plan: turn.plan, reply: turn.reply, command: turn.command, outcome: turn.outcome })
end

def status()
  let store = Agent::Store.status()
  let ai_config = Cosm::AI.config()
  let ai_health = Cosm::AI.health()
  let ai_status = { configured: ai_config.configured, health: ai_health.ok }
  let slack_status = {
    signing_secret: Agent::Config.slack_signing_secret() != false,
    bot_token: Agent::Config.slack_bot_token() != false,
    dm_enabled: true,
    mention_mode: true,
    channel_mentions_enabled: Agent::Config.slack_channel_ingress_enabled(),
    allowed_channels: Agent::Config.slack_allowed_channels()
  }
  let value = {
    name: identity().name,
    mode: identity().mode,
    control: identity().control,
    session_prefix: identity().session_prefix,
    persistence: identity().persistence,
    storage: store,
    ai: ai_status,
    slack: slack_status
  }
  value
end

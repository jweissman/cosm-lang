require "lib/agent/config"
require "lib/agent/slack_client"
require "lib/agent/runtime"

def required_ingress_scopes()
  let base = ["chat:write", "im:history"]
  Agent::Config.slack_channel_ingress_enabled() ? base.append("app_mentions:read").append("channels:history").append("groups:history") : base
end

def expected_events()
  let base = ["message.im"]
  Agent::Config.slack_channel_ingress_enabled() ? base.append("app_mention").append("message.channels").append("message.groups") : base
end

def visible_conversations()
  let listed = Agent::SlackClient.list_conversations()
  if listed.ok == false then
    listed
  else
    {
      ok: true,
      conversations: listed.conversations
    }
  end
end

def history(channel_id)
  let loaded = Agent::SlackClient.conversation_history(channel_id)
  if loaded.ok == false then
    loaded
  else
    {
      ok: true,
      channel_id: channel_id,
      messages: loaded.messages
    }
  end
end

def thread(channel_id, thread_ts)
  let loaded = Agent::SlackClient.conversation_thread(channel_id, thread_ts)
  if loaded.ok == false then
    loaded
  else
    {
      ok: true,
      channel_id: channel_id,
      thread_ts: thread_ts,
      messages: loaded.messages
    }
  end
end

def status()
  let auth = Agent::SlackClient.auth_status()
  {
    ok: auth.ok,
    auth: auth.ok ? auth.body : false,
    ingress: {
      webhook_driven: true,
      dm_enabled: true,
      mention_mode: true,
      channel_mentions_enabled: Agent::Config.slack_channel_ingress_enabled(),
      allowed_channels: Agent::Config.slack_allowed_channels(),
      expected_events: expected_events(),
      required_scopes: required_ingress_scopes()
    },
    runtime: Agent::Runtime.status()
  }
end

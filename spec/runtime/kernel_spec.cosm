require "cosm/spec.cosm"

suite("Kernel") do
  it("ambient assertions and dispatch stay available") do
    assert(Kernel.assert(true) == true)
    expect(Kernel.dispatch(1, :plus, 2)).to_eql(3)
  end
  it("explicit scalar helpers stay available") do
    expect("42".to_i()).to_eql(42)
    expect("3.5".to_f()).to_eql(3.5)
    expect(:status.to_s()).to_eql("status")
  end
  it("trace and validation helpers stay available") do
    expect(Kernel.trace("kernel spec", 41)).to_eql(41)
    expect(Kernel.tryValidate(42, Schema.number()).ok).to_be_truthy()
  end
end

"kernel spec complete"

require "cosm/spec.cosm"
require "examples/spec/index.cosm"

suite("Example corpus", ->() {
  Examples::Spec.catalog().map do |example|
    it(example.title, ->() {
      let session = Session.new()
      let result = session.eval(Kernel.readText(example.path))
      assert_equal(result, example.expected)
    })
  end
})

"example corpus spec complete"

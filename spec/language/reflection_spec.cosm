require "cosm/spec.cosm"

suite("Reflection", ->() {
  it("keeps receiver-side reflection compact", ->() {
    assert(Object.new().methods().any(->(name) { name == :send }), "Object methods still expose send")
    assert(Object.new().methods().any(->(name) { name == :inspect }), "Object methods still expose inspect")
    assert_equal(Object.new().method(:send).name, "send")
    assert(Object.methods().any(->(name) { name == :new }), "Object class methods still expose new")
    assert(Object.methods().any(->(name) { name == :include }), "Object class methods still expose include")
  })
})
